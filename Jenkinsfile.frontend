pipeline {
    agent any
    stages {
        stage('Code-Pull') {
            steps {
                git branch: 'dev', url: "https://github.com/deepbijwe/Med-ERP-Code.git"
            }
        }
        stage('Code-Build') {
            steps {
                dir('frontend') {
                    sh '''
                        npm install
                        npm run build
                    '''
                }
            }
        }
        stage('Deploy') {
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'AWS_Creds']]) {
                    dir('frontend') {
                        sh 'aws s3 sync dist/ s3://med-erp-static-web/'
                    }
                }
            }
        }
    }
}